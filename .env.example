# Copia este archivo como .env y llena los valores. Nunca subas .env al repositorio.

# development | test | production  (la cookie solo lleva la bandera "secure" en production)
NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=taplist
# Base separada que usan las pruebas automatizadas (se recrea en cada corrida)
PGDATABASE_TEST=taplist_test

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Vigencia del token y de la cookie de sesión
JWT_EXPIRACION_HORAS=8

# Límite de intentos de login
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
