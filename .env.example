# Copia este archivo como .env y llena los valores. Nunca subas .env al repositorio.

# development | test | production  (la cookie solo lleva la bandera "secure" en production)
NODE_ENV=development
PORT=3000

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=taplist
# Base separada que usan las pruebas automatizadas (se recrea en cada corrida)
PGDATABASE_TEST=taplist_test

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Vigencia del token y de la cookie de sesión
JWT_EXPIRACION_HORAS=8

# Límite de intentos fallidos de login dentro de la ventana:
#   por correo (se reinicia con un login exitoso) y por IP (más alto, porque
#   varios docentes pueden salir a internet por la misma IP de la escuela).
LOGIN_MAX_INTENTOS=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_VENTANA_MINUTOS=15

# --- Registro de asistencia por NFC ---
# Zona horaria de la escuela (IANA). Fechas, horas y días se calculan en
# esta zona, nunca en la del servidor.
ZONA_HORARIA_ESCUELA=America/Mexico_City
# Una lectura cuenta para una clase entre hora_inicio - MINUTOS_ANTES_CLASE
# y hora_inicio + MINUTOS_MAX_REGISTRO (o + tolerancia_min, si es mayor).
MINUTOS_ANTES_CLASE=15
MINUTOS_MAX_REGISTRO=60
# Antigüedad máxima de una lectura guardada sin conexión (campo leido_en).
HORAS_MAX_LECTURA_OFFLINE=24

# --- Límites de los dispositivos ---
# Solicitudes por minuto de cada dispositivo autenticado.
DISPOSITIVO_MAX_SOLICITUDES_MINUTO=60
# Fallos de autenticación de dispositivo permitidos por IP cada 15 minutos.
DISPOSITIVO_MAX_FALLOS_IP=30

# --- Aviso en tiempo real (SSE, GET /api/asistencias/eventos) ---
# Cada cuánto se manda un latido; en cada uno se revisa que la sesión siga vigente.
SSE_LATIDO_SEGUNDOS=25
# Conexiones simultáneas por docente (una por pestaña); la siguiente recibe 429.
SSE_MAX_CONEXIONES_DOCENTE=5

# --- Simulador de lecturas (npm run simular:lectura) ---
# Por defecto usa el dispositivo de la semilla. Esta clave es SOLO PARA
# DESARROLLO: solo existe en la semilla y nunca debe usarse en producción.
SIMULADOR_API_URL=http://localhost:3000
SIMULADOR_DISPOSITIVO_ID=1
SIMULADOR_DISPOSITIVO_CLAVE=dev-esp32-aula101-SoloDesarrollo-2026
